<IfModule mod_rewrite.c>
RewriteEngine On

# If file/folder exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect app root to signin
RewriteRule ^$ auth/signin [R=302,L]

# App routes
RewriteRule ^dashboard/?$ pages/dashboard/index.php [L,QSA]
RewriteRule ^admin/?$ pages/admin/index.php [L,QSA]
RewriteRule ^auth/signin/?$ pages/auth/signin/index.php [L,QSA]
RewriteRule ^auth/signup/?$ pages/auth/signup/index.php [L,QSA]
RewriteRule ^auth/signout/?$ pages/auth/signout/index.php [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
DirectoryIndex pages/auth/signin/index.php
RedirectMatch 307 ^/todolist/dashboard/?$ /todolist/pages/dashboard/index.php
RedirectMatch 307 ^/todolist/admin/?$ /todolist/pages/admin/index.php
RedirectMatch 307 ^/todolist/auth/signin/?$ /todolist/pages/auth/signin/index.php
RedirectMatch 307 ^/todolist/auth/signup/?$ /todolist/pages/auth/signup/index.php
RedirectMatch 307 ^/todolist/auth/signout/?$ /todolist/pages/auth/signout/index.php
</IfModule>
